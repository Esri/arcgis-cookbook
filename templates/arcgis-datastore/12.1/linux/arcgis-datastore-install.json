{
    "arcgis": {
        "version": "12.1",
        "run_as_user": "arcgis",
        "repository": {
            "archives": "/opt/software/archives",
            "setups": "/opt/software/setups",
            "local_patches": "/opt/software/archives/patches",
            "patches": "/opt/software/archives/patches",
            "patch_notification": {
                "products": [
                    "ArcGIS Data Store"
                ]
            }
        },
        "data_store": {
            "install_dir": "/opt",
            "setup_options": "-f Complete",
            "install_system_requirements": true,
            "preferredidentifier": "hostname",
            "data_dir": "/gisdata/arcgisdatastore",
            "patches": [
                "ArcGIS-121-DS-RSU-Patch-linux.tar"
            ]
        }
    },
    "run_list": [
        "recipe[arcgis-enterprise::system]",
        "recipe[arcgis-enterprise::install_datastore]",
        "recipe[arcgis-repository::patches]",
        "recipe[arcgis-enterprise::install_patches]",            
        "recipe[arcgis-enterprise::start_datastore]"
    ]
}
