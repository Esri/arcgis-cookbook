{
    "arcgis": {
        "repository": {
            "local_archives": "/opt/software/archives",
            "shared": false,
            "server": {
                "username": "<repository_username>",
                "password": "<repository_password>"
            },
            "files": {
                "ArcGIS_Notebook_Docker_Advanced_121_200176.tar.gz": {
                    "subfolder": "software/arcgis/12.1"
                },
                "ArcGIS_Notebook_Docker_Standard_121_200175.tar.gz": {
                    "subfolder": "software/arcgis/12.1"
                },
                "ArcGIS_Notebook_Server_Linux_121_200216.tar.gz": {
                    "subfolder": "software/arcgis/12.1"
                }
            }
        }
    },
    "run_list": [
        "recipe[arcgis-repository::fileserver]",
        "recipe[arcgis-repository::files]"
    ]
}
